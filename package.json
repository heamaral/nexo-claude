{
  "name": "nexo-claude",
  "version": "1.0.0-rc.5",
  "private": true,
  "type": "module",
  "description": "Project-local delivery planning, agent coordination and live kanban for Claude Code",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/*.spec.mjs",
    "check": "node scripts/check.mjs",
    "validate:plugin": "claude plugin validate plugins/nexo --strict",
    "start": "node plugins/nexo/runtime/cli.mjs board",
    "doctor": "node plugins/nexo/runtime/cli.mjs doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.316",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}

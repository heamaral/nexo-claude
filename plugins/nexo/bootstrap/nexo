#!/bin/sh
set -eu
bootstrap_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
case "$(uname -s):$(uname -m)" in
  Linux:x86_64) target=nexo-linux-amd64 ;;
  Linux:aarch64|Linux:arm64) target=nexo-linux-arm64 ;;
  Darwin:x86_64) target=nexo-darwin-amd64 ;;
  Darwin:arm64) target=nexo-darwin-arm64 ;;
  *) printf '%s\n' 'Nexo: unsupported OS/architecture for automatic runtime setup.' >&2; exit 1 ;;
esac
exec "$bootstrap_dir/$target" "$@"

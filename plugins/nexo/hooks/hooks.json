{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bootstrap/nexo",
            "args": ["--data", "${CLAUDE_PLUGIN_DATA}", "hook"],
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bootstrap/nexo",
            "args": ["--data", "${CLAUDE_PLUGIN_DATA}", "hook"],
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bootstrap/nexo",
            "args": ["--data", "${CLAUDE_PLUGIN_DATA}", "hook"],
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bootstrap/nexo",
            "args": ["--data", "${CLAUDE_PLUGIN_DATA}", "hook"],
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bootstrap/nexo",
            "args": ["--data", "${CLAUDE_PLUGIN_DATA}", "hook"],
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bootstrap/nexo",
            "args": ["--data", "${CLAUDE_PLUGIN_DATA}", "hook"],
            "timeout": 120
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bootstrap/nexo",
            "args": ["--data", "${CLAUDE_PLUGIN_DATA}", "hook"],
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bootstrap/nexo",
            "args": ["--data", "${CLAUDE_PLUGIN_DATA}", "hook"],
            "timeout": 120
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/runtime/cli.mjs",
              "hook"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/runtime/cli.mjs",
              "hook"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/runtime/cli.mjs",
              "hook"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/runtime/cli.mjs",
              "hook"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/runtime/cli.mjs",
              "hook"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/runtime/cli.mjs",
              "hook"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/runtime/cli.mjs",
              "hook"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/runtime/cli.mjs",
              "hook"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
